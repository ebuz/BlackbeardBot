# Environment overrides for BlackbeardBot
# Copy to /etc/default/blackbeard-bot and set values as needed.
# The systemd service loads this file automatically.

# Discord bot token (REQUIRED)
# DISCORD_TOKEN=""

# Wild Apricot API key (REQUIRED for member verification)
# WA_API_KEY=""

# Wild Apricot account ID (REQUIRED)
# WA_ACCOUNT_ID=0

# Google Sheets spreadsheet ID (required for workhours)
# GOOGLE_SPREADSHEET_ID=""

# Google service account JSON — path to file or inline JSON string
# GOOGLE_SERVICE_ACCOUNT_JSON="data/google_credentials.json"

# Data file paths (defaults to /var/lib/blackbeard-bot/data/ when deployed)
# VERIFY_MESSAGE_STATE_FILE="data/verify_message.json"
# ROLE_PANEL_STATE_FILE="data/role_panels.json"
# VERIFIED_MEMBERS_FILE="data/verified_members.json"

# Google Drive backup (for daily verified_members.json upload)
# GDRIVE_CLIENT_SECRET="gdrive_client_secret.json"
# GDRIVE_TOKEN_FILE="token_gdrive.json"
# GDRIVE_BACKUP_FOLDER_ID=""
