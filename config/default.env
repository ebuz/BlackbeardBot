# Environment overrides for BlackbeardBot
# Copy to /etc/default/blackbeard-bot and set values as needed.
# The systemd service loads this file automatically.

# Discord bot token (REQUIRED)
# DISCORD_TOKEN=""

# Wild Apricot API key (REQUIRED for member verification)
# WA_API_KEY=""

# Wild Apricot account ID (REQUIRED)
# WA_ACCOUNT_ID=0

# Google Sheets spreadsheet ID (required for workhours)
# GOOGLE_SPREADSHEET_ID=""

# Google service account JSON — path to file or inline JSON string
# Default: /etc/blackbeard-bot/credentials/google_credentials.json
# GOOGLE_SERVICE_ACCOUNT_JSON="/etc/blackbeard-bot/credentials/google_credentials.json"

# Google OAuth client secret (for Drive backup)
# Default: /etc/blackbeard-bot/credentials/gdrive_client_secret.json
# GOOGLE_CLIENT_SECRET="/etc/blackbeard-bot/credentials/gdrive_client_secret.json"

# OAuth token file (auto-generated on first Drive backup run)
# Default: /etc/blackbeard-bot/credentials/token_gdrive.json
# GOOGLE_TOKEN_FILE="/etc/blackbeard-bot/credentials/token_gdrive.json"

# Google Drive folder ID for daily verified_members.json backup
# GOOGLE_DRIVE_FOLDER_ID=""

# Data file paths (defaults to /var/lib/blackbeard-bot/data/ when deployed)
# VERIFY_MESSAGE_STATE_FILE="data/verify_message.json"
# ROLE_PANEL_STATE_FILE="data/role_panels.json"
# VERIFIED_MEMBERS_FILE="data/verified_members.json"